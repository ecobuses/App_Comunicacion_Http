####### Compile

hilo.o: ../../hilo.cpp ../../hilo.h \
		../../util.h \
		../../manipuar_archivos.h \
		../../servidor.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o hilo.o ../../hilo.cpp

main.o: ../../main.cpp ../../hilo.h \
		../../util.h \
		../../manipuar_archivos.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../../main.cpp

manipuar_archivos.o: ../../manipuar_archivos.cpp ../../manipuar_archivos.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o manipuar_archivos.o ../../manipuar_archivos.cpp

servidor.o: ../../servidor.cpp ../../servidor.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o servidor.o ../../servidor.cpp

util.o: ../../util.cpp ../../util.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o util.o ../../util.cpp

moc_servidor.o: moc_servidor.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_servidor.o moc_servidor.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/AppComunicacionTelemetria/bin || mkdir -p $(INSTALL_ROOT)/opt/AppComunicacionTelemetria/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/AppComunicacionTelemetria/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/AppComunicacionTelemetria/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/AppComunicacionTelemetria/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/AppComunicacionTelemetria/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

